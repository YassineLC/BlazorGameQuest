@page "/admin/scores"
@using Microsoft.AspNetCore.Authorization
@using SharedModels.Models.Admin
@inject BlazorGame.Client.Services.Admin.IAdminApiClient AdminApiClient
@attribute [Authorize(Roles = "admin,Admin")]

<PageTitle>Scores Admin - BlazorGameQuest</PageTitle>

<section class="admin-shell admin-scores container-fluid py-4">
    <header class="admin-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-2">Gestion des scores</h1>
            <p class="admin-subtitle">Analysez les performances et détectez les exploits hors norme.</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-secondary">← Retour tableau de bord</a>
    </header>

    @if (stats is not null)
    {
        <div class="row g-4 mb-4 admin-stats-grid">
            <div class="col-md-4 col-sm-6">
                <article class="card card-medieval admin-stat-card">
                    <h5>Score moyen</h5>
                    <p class="admin-stat-value">@stats.AverageScore</p>
                </article>
            </div>
            <div class="col-md-4 col-sm-6">
                <article class="card card-medieval admin-stat-card">
                    <h5>Meilleur score</h5>
                    <p class="admin-stat-value">@stats.MaxScore</p>
                </article>
            </div>
            <div class="col-md-4 col-sm-6">
                <article class="card card-medieval admin-stat-card">
                    <h5>Total cumulé</h5>
                    <p class="admin-stat-value">@stats.TotalScores</p>
                </article>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Chargement des scores...</span>
        </div>
    }
    else if (scores.Count == 0)
    {
        <div class="alert alert-info admin-alert">Aucun score enregistré pour le moment.</div>
    }
    else
    {
        <div class="table-responsive admin-table-wrapper">
            <table class="table table-striped table-hover card-medieval admin-table">
                <thead>
                    <tr>
                        <th>Joueur</th>
                        <th>Donjon</th>
                        <th>Score</th>
                        <th>Kills</th>
                        <th>Trésors</th>
                        <th>Pièges évités</th>
                        <th>Boss</th>
                        <th>Obtenu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var score in scores)
                    {
                        <tr>
                            <td class="fw-bold">@score.PlayerName</td>
                            <td>@score.DungeonName</td>
                            <td class="admin-cell-highlight">@score.FinalScore</td>
                            <td>@score.KillCount</td>
                            <td>@score.TreasureCount</td>
                            <td>@score.TrapAvoidedCount</td>
                            <td>@(score.IsBossDefeated ? "Oui" : "Non")</td>
                            <td>@score.AchievedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly List<ScoreAdminDto> scores = new();
    private ScoresStatsDto? stats;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            var data = await AdminApiClient.GetScoresAsync();
            scores.Clear();
            scores.AddRange(data);
            stats = await AdminApiClient.GetScoresStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur scores: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
