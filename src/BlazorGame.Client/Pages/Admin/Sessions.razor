@page "/admin/sessions"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Sessions Admin - BlazorGameQuest</PageTitle>

<div class="admin-sessions container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des Parties</h1>
        <a href="/admin/dashboard" class="btn btn-secondary">← Retour</a>
    </div>

    @if (sessions == null)
    {
        <p class="text-center"><span class="spinner-border spinner-border-sm me-2"></span>Chargement...</p>
    }
    else if (!sessions.Any())
    {
        <div class="alert alert-info">Aucune partie enregistrée.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped card-medieval">
                <thead>
                    <tr>
                        <th>ID Partie</th>
                        <th>Joueur</th>
                        <th>Donjon</th>
                        <th>Profondeur / Max</th>
                        <th>Score Final</th>
                        <th>État</th>
                        <th>Début</th>
                        <th>Fin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in sessions)
                    {
                        <tr>
                            <td>@session.Id.ToString().Substring(0, 8)...</td>
                            <td>@session.PlayerName</td>
                            <td>@session.DungeonName</td>
                            <td>@session.MaxDepthReached</td>
                            <td class="fw-bold">@session.FinalScore</td>
                            <td>
                                @if (session.IsFinished)
                                {
                                    <span class="badge bg-success">Terminée</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">En cours</span>
                                }
                            </td>
                            <td>@session.StartedAt.ToLocalTime().ToString("g")</td>
                            <td>@session.FinishedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject]
    private HttpClient Http { get; set; } = null!;

    private List<SessionInfo>? sessions;

    private class SessionInfo
    {
        public Guid Id { get; set; }
        public string PlayerName { get; set; } = string.Empty;
        public string DungeonName { get; set; } = string.Empty;
        public int MaxDepthReached { get; set; }
        public int FinalScore { get; set; }
        public bool IsFinished { get; set; }
        public DateTime StartedAt { get; set; }
        public DateTime FinishedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        try
        {
            sessions = await Http.GetFromJsonAsync<List<SessionInfo>>("api/admin/sessions") ?? new List<SessionInfo>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur sessions: {ex.Message}");
        }
    }
}
