@page "/admin/players"
@using Microsoft.AspNetCore.Authorization
@using SharedModels.Models.Admin
@inject BlazorGame.Client.Services.Admin.IAdminApiClient AdminApiClient
@attribute [Authorize(Roles = "admin,Admin")]
@implements IDisposable

<PageTitle>Gestion Joueurs - BlazorGameQuest</PageTitle>

<section class="admin-shell admin-players container-fluid py-4">
    <header class="admin-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-2">Gestion des Joueurs</h1>
            <p class="admin-subtitle">Surveillez l'activité des aventuriers et gérez leurs droits d'accès.</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-secondary">← Retour tableau de bord</a>
    </header>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Chargement des joueurs...</span>
        </div>
    }
    else if (players.Count == 0)
    {
        <div class="alert alert-info admin-alert">Aucun joueur enregistré pour le moment.</div>
    }
    else
    {
        <div class="table-responsive admin-table-wrapper">
            <table class="table table-striped table-hover card-medieval admin-table">
                <thead>
                    <tr>
                        <th>Identifiant</th>
                        <th>Nom d'utilisateur</th>
                        <th>Email</th>
                        <th>Parties Jouées</th>
                        <th>Score Moyen</th>
                        <th>État</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in players)
                    {
                        <tr>
                            <td><code>@player.Id.ToString().Substring(0, 8)</code></td>
                            <td class="fw-bold">@player.Username</td>
                            <td>@player.Email</td>
                            <td>@player.SessionCount</td>
                            <td>@player.AverageScore</td>
                            <td>
                                @if (player.IsActive)
                                {
                                    <span class="badge admin-badge-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge admin-badge-danger">Désactivé</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (player.IsActive)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => UpdatePlayerStatus(player.Id, false)">Désactiver</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => UpdatePlayerStatus(player.Id, true)">Activer</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource _cts = new();
    private readonly List<PlayerAdminDto> players = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayersAsync();
    }

    private async Task LoadPlayersAsync()
    {
        try
        {
            isLoading = true;
            var data = await AdminApiClient.GetPlayersAsync(_cts.Token);
            players.Clear();
            players.AddRange(data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des joueurs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdatePlayerStatus(Guid playerId, bool isActive)
    {
        try
        {
            await AdminApiClient.SetPlayerStatusAsync(playerId, isActive, _cts.Token);
            await LoadPlayersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la mise à jour du joueur: {ex.Message}");
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
