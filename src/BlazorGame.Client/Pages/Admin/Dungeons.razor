@page "/admin/dungeons"
@using Microsoft.AspNetCore.Authorization
@using SharedModels.Models.Admin
@inject BlazorGame.Client.Services.Admin.IAdminApiClient AdminApiClient
@attribute [Authorize(Roles = "admin,Admin")]

<PageTitle>Donjons Admin - BlazorGameQuest</PageTitle>

<section class="admin-shell admin-dungeons container-fluid py-4">
    <header class="admin-header d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-2">Gestion des donjons</h1>
            <p class="admin-subtitle">Téléchargez l'ensemble des donjons générés pour les joueurs</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-secondary">← Retour tableau de bord</a>
    </header>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <span class="spinner-border spinner-border-sm me-2"></span>
            <span>Chargement des donjons...</span>
        </div>
    }
    else if (dungeons.Count == 0)
    {
        <div class="alert alert-info admin-alert">Aucun donjon enregistré pour le moment.</div>
    }
    else
    {
        <div class="table-responsive admin-table-wrapper">
            <table class="table table-striped table-hover card-medieval admin-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Profondeur max</th>
                        <th>Salles</th>
                        <th>Événements</th>
                        <th>Sessions</th>
                        <th>Création</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dungeon in dungeons)
                    {
                        <tr>
                            <td class="fw-bold">@dungeon.Name</td>
                            <td>@dungeon.MaxDepth</td>
                            <td>@dungeon.RoomCount</td>
                            <td>@dungeon.EventCount</td>
                            <td>@dungeon.SessionCount</td>
                            <td>@dungeon.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly List<DungeonAdminDto> dungeons = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadDungeonsAsync();
    }

    private async Task LoadDungeonsAsync()
    {
        try
        {
            isLoading = true;
            var data = await AdminApiClient.GetDungeonsAsync();
            dungeons.Clear();
            dungeons.AddRange(data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des donjons: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
