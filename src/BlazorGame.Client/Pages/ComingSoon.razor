@page "/coming-soon"

<PageTitle>Fonctionnalité À Venir - BlazorGameQuest</PageTitle>

<div class="coming-soon-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="coming-soon-card text-center">
                    <div class="mb-4">
                        <h2>🚧 Fonctionnalité À Venir ⚡</h2>
                        <p class="lead">Cette fonctionnalité est en cours de développement et sera disponible prochainement.</p>
                    </div>

                    <div class="features-preview mb-4">
                        <h4>🔮 Ce qui arrive bientôt :</h4>
                        <ul class="list-unstyled">
                            <li>🎮 Système de jeu complet</li>
                            <li>🏰 Exploration de donjons</li>
                            <li>⚔️ Combats tactiques</li>
                            <li>🏆 Système de scores</li>
                            <li>📈 Progression du joueur</li>
                        </ul>
                    </div>

                    <div class="navigation-buttons">
                        <a href="/player/dashboard" class="btn btn-primary btn-lg me-2">
                            📊 Tableau de Bord
                        </a>
                        <a href="/" class="btn btn-secondary btn-lg">
                            🏠 Accueil
                        </a>
                    </div>

                    <div class="mt-4">
                        <small class="text-muted">
                            Restez connecté pour découvrir les nouvelles fonctionnalités !
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .coming-soon-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        background: linear-gradient(45deg, #2d2d2d 0%, #3a3a3a 50%, #2d2d2d 100%);
        margin-top: -1.1rem;
        position: relative;
    }

    .coming-soon-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
            repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(201, 170, 113, 0.1) 2px,
                rgba(201, 170, 113, 0.1) 4px
            );
        pointer-events: none;
    }

    .coming-soon-card {
        background: linear-gradient(145deg, #4a4a4a, #3a3a3a);
        border: 3px solid #666666;
        border-radius: 0;
        box-shadow: 6px 6px 0px #2a2a2a, inset 2px 2px 0px #5a5a5a;
        padding: 3rem 2rem;
        position: relative;
    }

    .coming-soon-card::before {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        background: linear-gradient(45deg, #c9aa71, #8b7355);
        z-index: -1;
        border-radius: 0;
    }

    .features-preview ul li {
        margin-bottom: 0.5rem;
        font-family: 'Silkscreen', monospace;
        font-size: 12px;
        color: #d0d0d0;
    }

    .coming-soon-card h2 {
        color: #c9aa71;
        text-shadow: 2px 2px 0px #1a1a1a;
    }

    .coming-soon-card h4 {
        color: #c9aa71;
        font-size: 16px;
    }

    .coming-soon-card .lead {
        font-family: 'Silkscreen', monospace;
        font-size: 14px;
        color: #aaaaaa;
    }

    .coming-soon-card small {
        font-family: 'Silkscreen', monospace;
        font-size: 10px;
        color: #888888;
    }
</style>