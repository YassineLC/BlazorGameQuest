@page "/"
@page "/home"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>BlazorGameQuest - Accueil</PageTitle>

<div class="hero-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <div class="mb-2">
                    <img src="/logo.png" alt="BlazorGameQuest Logo" class="hero-logo" />
                </div>
                <h1 class="display-4 mb-4">BlazorGameQuest</h1>
                <p class="lead mb-4">
                    Incarnez un aventurier et explorez des donjons générés aléatoirement.
                    Faites des choix stratégiques pour survivre et gagner des points !
                </p>
                
                <AuthorizeView>
                    <Authorized>
                        <div class="d-grid gap-2 d-md-block">
                            <a href="/player/dashboard" class="btn btn-primary btn-lg me-2">
                                Mon Tableau de Bord
                            </a>
                            <a href="/game/new-adventure" class="btn btn-success btn-lg">
                                Nouvelle Aventure
                            </a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-grid gap-2 d-md-block">
                            <a href="/auth/login" class="btn btn-primary btn-lg me-2">
                                Se connecter
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>

<div class="features-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-md-4 text-center mb-4">
                <div class="feature-card h-100">
                    <h3>Donjons Aléatoires</h3>
                    <p>Chaque aventure est unique avec des salles générées aléatoirement et des défis variés.</p>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="feature-card h-100">
                    <h3>Choix Stratégiques</h3>
                    <p>Combattre, fouiller, fuir... Vos décisions déterminent votre survie et vos gains.</p>
                </div>
            </div>
            <div class="col-md-4 text-center mb-4">
                <div class="feature-card h-100">
                    <h3>Classements</h3>
                    <p>Comparez vos scores avec les autres aventuriers et grimpez dans le classement.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rules-section py-3">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-11 col-md-12">
                <div class="rules-footer">
                    <div class="rules-call-to-action">
                        <h4>Prêt à écrire votre légende ?</h4>
                        <p>Chaque aventure est unique, générée aléatoirement pour vous offrir des défis toujours renouvelés.</p>
                        <a href="/game/new-adventure" class="btn btn-primary btn-lg">
                            <i data-feather="zap"></i>
                            Commencer l'Aventure
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Pas de code nécessaire, AuthorizeView gère tout
}
