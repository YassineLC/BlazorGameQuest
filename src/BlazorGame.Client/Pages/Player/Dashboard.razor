@page "/player/dashboard"

<PageTitle>Tableau de Bord - BlazorGameQuest</PageTitle>

<div class="dashboard-container">
    <!-- En-tête du tableau de bord -->
    <section class="dashboard-header">
        <div class="hero-welcome">
            <div class="hero-content">
                <h1 class="hero-title">Bienvenue, Noble @playerName</h1>
            </div>
            <div class="hero-stats">
                <div class="stat-item">
                    <div class="stat-value">@totalScore</div>
                    <div class="stat-label">Points d'Honneur</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@gamesPlayed</div>
                    <div class="stat-label">Expéditions</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">@(playerRank > 0 ? "#" + playerRank : "---")</div>
                    <div class="stat-label">Rang</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Actions principales -->
    <section class="dashboard-actions">
        <div class="action-grid">
            <div class="action-card action-card-primary">
                <div class="action-icon">
                    <i data-feather="zap"></i>
                </div>
                <div class="action-content">
                    <h3>Nouvelle Quête</h3>
                    <p>Partez à l'aventure dans un donjon mystérieux</p>
                    <a href="/game/new-adventure" class="btn btn-primary">
                        <i data-feather="play"></i>
                        Commencer l'Aventure
                    </a>
                </div>
            </div>

            <div class="action-card action-card-secondary">
                <div class="action-icon">
                    <i data-feather="file-text"></i>
                </div>
                <div class="action-content">
                    <h3>Historique</h3>
                    <p>Consultez l'historique de vos précédentes parties</p>
                    <a href="/player/history" class="btn btn-secondary">
                        <i data-feather="book-open"></i>
                        Voir l'Historique
                    </a>
                </div>
            </div>

            <div class="action-card action-card-accent">
                <div class="action-icon">
                    <i data-feather="award"></i>
                </div>
                <div class="action-content">
                    <h3>Classements</h3>
                    <p>Découvrez qui domine le classement</p>
                    <a href="/leaderboard" class="btn btn-accent">
                        <i data-feather="award"></i>
                        Voir le Classement
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Contenu principal -->
    <section class="dashboard-content">
        <div class="content-grid">
            <!-- Historique récent -->
            <div class="dashboard-card recent-adventures">
                <div class="card-header">
                    <h3>
                        <i data-feather="clock"></i>
                        Dernières Expéditions
                    </h3>
                </div>
                <div class="card-body">
                    @if (recentGames.Any())
                    {
                        <div class="adventures-list">
                            @foreach (var game in recentGames.Take(4))
                            {
                                <div class="adventure-item">
                                    <div class="adventure-icon">
                                        <i data-feather="@(game.IsCompleted ? "check-circle" : "x-circle")"></i>
                                    </div>
                                    <div class="adventure-info">
                                        <div class="adventure-title">
                                            Donjon de @game.RoomsExplored salles
                                        </div>
                                        <div class="adventure-meta">
                                            @game.Date.ToString("dd MMM yyyy") • @game.Score pts
                                        </div>
                                    </div>
                                    <div class="adventure-status @(game.IsCompleted ? "status-success" : "status-danger")">
                                        @(game.IsCompleted ? "Victoire" : "Défaite")
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            <a href="/player/history" class="btn btn-outline">
                                Voir toutes les aventures
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i data-feather="map"></i>
                            <h4>Aucune aventure</h4>
                            <p>Votre première quête vous attend !</p>
                            <a href="/game/new-adventure" class="btn btn-primary">
                                Commencer maintenant
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Classement -->
            <div class="dashboard-card leaderboard-preview">
                <div class="card-header">
                    <h3>
                        <i data-feather="users"></i>
                        Hall des Champions
                    </h3>
                </div>
                <div class="card-body">
                    @if (topPlayers.Any())
                    {
                        <div class="champions-list">
                            @for (int i = 0; i < Math.Min(topPlayers.Count, 5); i++)
                            {
                                <div class="champion-item @(i < 3 ? "champion-podium" : "")">
                                    <div class="champion-rank">
                                        @if (i == 0) { <i data-feather="award"></i> }
                                        else if (i == 1) { <span class="rank-medal silver">2</span> }
                                        else if (i == 2) { <span class="rank-medal bronze">3</span> }
                                        else { <span class="rank-number">@(i + 1)</span> }
                                    </div>
                                    <div class="champion-name">@topPlayers[i].Name</div>
                                    <div class="champion-score">@topPlayers[i].Score</div>
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            <a href="/leaderboard" class="btn btn-outline">
                                Voir le classement complet
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i data-feather="star"></i>
                            <h4>Hall vide</h4>
                            <p>Soyez le premier héros !</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string playerName = "Aventurier"; // TODO: Récupérer depuis l'auth
    private int totalScore = 0; // À récupérer depuis l'API
    private int gamesPlayed = 0; // À récupérer depuis l'API  
    private int playerRank = 0; // À récupérer depuis l'API

    private List<GameSummary> recentGames = new();
    private List<PlayerScore> topPlayers = new();

    protected override void OnInitialized()
    {
        LoadRecentGames();
        LoadTopPlayers();
    }

    private void LoadRecentGames()
    {
        // TODO: Appel API - await GameService.GetRecentGamesAsync()
        recentGames = new List<GameSummary>(); // À venir
    }

    private void LoadTopPlayers()
    {
        // TODO: Appel API - await LeaderboardService.GetTopPlayersAsync()
        topPlayers = new List<PlayerScore>(); // À venir
    }

    public class GameSummary
    {
        public DateTime Date { get; set; }
        public int RoomsExplored { get; set; }
        public int Score { get; set; }
        public bool IsCompleted { get; set; }
    }

    public class PlayerScore
    {
        public string Name { get; set; } = string.Empty;
        public int Score { get; set; }
    }
}