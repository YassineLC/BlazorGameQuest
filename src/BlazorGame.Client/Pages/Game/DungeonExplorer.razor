@page "/game/dungeon"

<PageTitle>Exploration - BlazorGameQuest</PageTitle>

<div class="dungeon-explorer">
    <div class="container-fluid px-4 py-3">
        @if (dungeon == null)
        {
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="mt-3">Chargement du donjon...</p>
            </div>
        }
        else if (currentRoom == null)
        {
            <div class="alert alert-warning text-center mt-5 card-medieval">
                <h4>Aucune salle active</h4>
                <a href="/game/new-adventure" class="btn btn-primary mt-3">Créer une nouvelle aventure</a>
            </div>
        }
        else
        {
            @if (nextRooms.Count > 0)
            {
                <!-- En-tête avec infos donjon (caché après fin) -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="dungeon-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h2 class="mb-0 text-uppercase">@dungeon.Name</h2>
                                    <small class="text-muted">Profondeur @currentRoom.Depth / @dungeon.MaxDepth</small>
                                </div>
                                <div>
                                    <span class="badge badge-primary me-2">Profondeur max: @dungeon.MaxDepth</span>
                                    <span class="badge badge-success">Points: @totalPoints</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Salle actuelle -->
            @if (nextRooms.Count > 0)
            {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="current-room-card room-type-@((int)currentRoom.Type)">
                        <div class="room-header">
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <h3 class="mb-1 text-uppercase">@currentRoom.Name</h3>
                                    <span class="room-type-label">@GetRoomTypeLabel(currentRoom.Type)</span>
                                </div>
                                <div class="room-badges">
                                    <span class="badge badge-secondary">Profondeur @currentRoom.Depth</span>
                                    <span class="badge badge-success ms-2">+@currentRoom.PointsReward pts</span>
                                </div>
                            </div>
                        </div>
                        <div class="room-body">
                            <p class="room-description">@currentRoom.Description</p>
                            
                            @if (currentRoom.Type == RoomType.Boss)
                            {
                                <div class="room-alert alert-danger">
                                    <strong>⚔️ BOSS!</strong> Préparez-vous à un combat épique!
                                </div>
                            }
                            else if (currentRoom.Type == RoomType.Treasure)
                            {
                                <div class="room-alert alert-treasure">
                                    <strong>💎 Trésor!</strong> Vous avez trouvé des richesses!
                                </div>
                            }
                            else if (currentRoom.Type == RoomType.Rest)
                            {
                                <div class="room-alert alert-rest">
                                    <strong>🛡️ Repos</strong> Vous pouvez récupérer ici.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            }

            <!-- Actions / Salles suivantes -->
            @if (nextRooms.Count > 0)
            {
                <div class="row">
                    <div class="col-12">
                        <div class="choices-container">
                            <h4 class="choices-title text-uppercase text-center mb-3">Choisissez votre chemin</h4>
                            <div class="room-choices-grid">
                                @foreach (var room in nextRooms)
                                {
                                    <div class="room-choice room-choice-type-@((int)room.Type)" @onclick="() => NavigateToRoom(room.Id)">
                                        <div class="room-choice-header">
                                            <span class="room-choice-type">@GetRoomTypeLabel(room.Type)</span>
                                        </div>
                                        <div class="room-choice-body">
                                            <h5 class="room-choice-name">@room.Name</h5>
                                            <p class="room-choice-desc">@GetShortDescription(room.Description)</p>
                                            <div class="room-choice-footer">
                                                <span class="badge badge-secondary">Prof. @room.Depth</span>
                                                <span class="badge badge-success">+@room.PointsReward pts</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="dungeon-complete">
                            <h4 class="text-center mb-3">🎉 Donjon Terminé!</h4>
                            <p class="text-center">Vous avez complété le donjon avec <strong>@totalPoints points</strong>!</p>
                            <div class="text-center">
                                <a href="/game/new-adventure" class="btn btn-primary me-2">Nouvelle Aventure</a>
                                <a href="/player/history" class="btn btn-primary me-2">Voir l'historique</a>
                                <a href="/player/dashboard" class="btn btn-primary">Tableau de Bord</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private Dungeon? dungeon;
    private Room? currentRoom;
    private List<Room> nextRooms = new();
    private int totalPoints = 0;

    protected override async Task OnInitializedAsync()
    {
        dungeon = DungeonService.CurrentDungeon;
        currentRoom = DungeonService.CurrentRoom;

        if (dungeon == null || currentRoom == null)
        {
            // Pas de donjon actif, rediriger
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/game/new-adventure");
            return;
        }

        // Charger les salles suivantes dès l'initialisation
        nextRooms = DungeonService.GetNextRooms();
        totalPoints = 0;

        // Enregistrer la visite de la salle courante (une seule fois) pour l'historique
        if (currentRoom != null && GameService.CurrentSessionId != null && !DungeonService.HasVisited(currentRoom.Id))
        {
            var visit = await GameService.VisitRoomAsync(GameService.CurrentSessionId.Value, currentRoom.Id, null);
            if (visit != null)
            {
                totalPoints = visit.NewScore;
                DungeonService.MarkVisited(currentRoom.Id);
            }
            else
            {
                totalPoints = currentRoom.PointsReward;
            }

            // Rafraîchir après l'appel serveur
            nextRooms = DungeonService.GetNextRooms();
        }
        else
        {
            totalPoints = currentRoom?.PointsReward ?? 0;
        }
    }

    private void NavigateToRoom(Guid roomId)
    {
        // Rester sur l'overlay DungeonExplorer et persister la progression
        var room = DungeonService.NavigateToRoom(roomId);
        if (room is null) return;

        currentRoom = room;

        if (GameService.CurrentSessionId != null && !DungeonService.HasVisited(currentRoom.Id))
        {
            _ = PersistVisitAndRefreshAsync(currentRoom.Id);
        }
        else
        {
            totalPoints += currentRoom.PointsReward;
            nextRooms = DungeonService.GetNextRooms();
            StateHasChanged();
        }
    }

    private async Task PersistVisitAndRefreshAsync(Guid roomId)
    {
        var visit = await GameService.VisitRoomAsync(GameService.CurrentSessionId!.Value, roomId, null);
        if (visit != null)
        {
            totalPoints = visit.NewScore;
            DungeonService.MarkVisited(roomId);
        }

        nextRooms = DungeonService.GetNextRooms();

        // Si plus de salles: clôturer et permettre l'historique
        if (nextRooms.Count == 0 || (visit?.IsFinished ?? false))
        {
            if (GameService.CurrentSessionId != null)
            {
                await GameService.EndSessionAsync(GameService.CurrentSessionId.Value);
            }
        }

        StateHasChanged();
    }

    private string GetRoomTypeLabel(RoomType type) => type switch
    {
        RoomType.Start => "Départ",
        RoomType.Combat => "Combat",
        RoomType.Treasure => "Trésor",
        RoomType.Event => "Événement",
        RoomType.Shop => "Boutique",
        RoomType.Rest => "Repos",
        RoomType.Boss => "Boss",
        _ => "Inconnu"
    };

    private string GetShortDescription(string description)
    {
        if (description.Length <= 80) return description;
        return description.Substring(0, 77) + "...";
    }
}

@inject DungeonService DungeonService
@inject NavigationManager NavigationManager
@inject GameService GameService

