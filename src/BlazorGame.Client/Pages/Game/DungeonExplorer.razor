@page "/game/dungeon"

<PageTitle>Exploration - BlazorGameQuest</PageTitle>

<div class="dungeon-explorer">
    <div class="container-fluid">
        @if (dungeon == null)
        {
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="mt-3">Chargement du donjon...</p>
            </div>
        }
        else if (currentRoom == null)
        {
            <div class="alert alert-warning text-center mt-5">
                <h4>Aucune salle active</h4>
                <a href="/game/new-adventure" class="btn btn-primary mt-3">Créer une nouvelle aventure</a>
            </div>
        }
        else
        {
            <!-- En-tête avec infos donjon -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card bg-dark text-white">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h4 class="mb-0">@dungeon.Name</h4>
                                    <small class="text-muted">Profondeur @currentRoom.Depth / @dungeon.MaxDepth</small>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span class="badge bg-info me-2">Profondeur max: @dungeon.MaxDepth</span>
                                    <span class="badge bg-warning">Points: @totalPoints</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Salle actuelle -->
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card room-card mb-4">
                        <div class="card-header bg-@GetRoomTypeColor(currentRoom.Type)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h3 class="mb-0">@currentRoom.Name</h3>
                                    <small>@GetRoomTypeLabel(currentRoom.Type)</small>
                                </div>
                                <div>
                                    <span class="badge bg-light text-dark">Profondeur @currentRoom.Depth</span>
                                    <span class="badge bg-success ms-2">+@currentRoom.PointsReward pts</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="lead">@currentRoom.Description</p>
                            
                            @if (currentRoom.Type == RoomType.Boss)
                            {
                                <div class="alert alert-danger">
                                    <strong>⚔️ BOSS!</strong> Préparez-vous à un combat épique!
                                </div>
                            }
                            else if (currentRoom.Type == RoomType.Treasure)
                            {
                                <div class="alert alert-success">
                                    <strong>💎 Trésor!</strong> Vous avez trouvé des richesses!
                                </div>
                            }
                            else if (currentRoom.Type == RoomType.Rest)
                            {
                                <div class="alert alert-info">
                                    <strong>🛡️ Repos</strong> Vous pouvez récupérer ici.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Actions / Salles suivantes -->
                    @if (nextRooms.Count > 0)
                    {
                        <div class="card">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0">Choisissez votre chemin</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @foreach (var room in nextRooms)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="card h-100 room-choice" @onclick="() => NavigateToRoom(room.Id)">
                                                <div class="card-body">
                                                    <h5 class="card-title">
                                                        <span class="badge bg-@GetRoomTypeColor(room.Type) me-2">
                                                            @GetRoomTypeLabel(room.Type)
                                                        </span>
                                                        @room.Name
                                                    </h5>
                                                    <p class="card-text small">@room.Description.Substring(0, Math.Min(100, room.Description.Length))...</p>
                                                    <div class="mt-2">
                                                        <span class="badge bg-secondary">Profondeur @room.Depth</span>
                                                        <span class="badge bg-success">+@room.PointsReward pts</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-body text-center">
                                <h4>🎉 Donjon Terminé!</h4>
                                <p>Vous avez complété le donjon avec <strong>@totalPoints points</strong>!</p>
                                <a href="/game/new-adventure" class="btn btn-primary">Nouvelle Aventure</a>
                                <a href="/player/dashboard" class="btn btn-secondary">Tableau de Bord</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .room-choice {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .room-choice:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
</style>

@code {
    private Dungeon? dungeon;
    private Room? currentRoom;
    private List<Room> nextRooms = new();
    private int totalPoints = 0;

    protected override async Task OnInitializedAsync()
    {
        dungeon = DungeonService.CurrentDungeon;
        currentRoom = DungeonService.CurrentRoom;

        if (dungeon == null || currentRoom == null)
        {
            // Pas de donjon actif, rediriger
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/game/new-adventure");
            return;
        }

        // Charger les salles suivantes dès l'initialisation
        nextRooms = DungeonService.GetNextRooms();
        totalPoints = currentRoom?.PointsReward ?? 0;
    }

    private void NavigateToRoom(Guid roomId)
    {
        currentRoom = DungeonService.NavigateToRoom(roomId);
        
        if (currentRoom != null)
        {
            // Ajouter les points de la nouvelle salle
            totalPoints += currentRoom.PointsReward;
            
            // Charger les prochaines salles
            nextRooms = DungeonService.GetNextRooms();
        }
        
        StateHasChanged();
    }

    private string GetRoomTypeColor(RoomType type) => type switch
    {
        RoomType.Start => "primary",
        RoomType.Combat => "danger",
        RoomType.Treasure => "warning",
        RoomType.Event => "info",
        RoomType.Shop => "success",
        RoomType.Rest => "secondary",
        RoomType.Boss => "dark",
        _ => "light"
    };

    private string GetRoomTypeLabel(RoomType type) => type switch
    {
        RoomType.Start => "Départ",
        RoomType.Combat => "Combat",
        RoomType.Treasure => "Trésor",
        RoomType.Event => "Événement",
        RoomType.Shop => "Boutique",
        RoomType.Rest => "Repos",
        RoomType.Boss => "Boss",
        _ => "Inconnu"
    };
}

@inject DungeonService DungeonService
@inject NavigationManager NavigationManager
