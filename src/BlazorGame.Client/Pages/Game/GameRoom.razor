@page "/game/room/{RoomId:guid}"

<PageTitle>Salle @RoomId - BlazorGameQuest</PageTitle>

<div class="game-room-fullscreen">
    <div class="container-fluid h-100">
        <!-- Header compact -->
        <div class="row game-header-row">
            <div class="col-12">
                <div class="room-header-compact">
                    <div class="header-left">
                        <div class="room-progress">@((currentRoom?.Order ?? 0)) / @totalRooms</div>
                        <h2 class="room-title">@((currentRoom?.Name) ?? ($"Salle {RoomId}"))</h2>
                    </div>
                    <div class="header-right">
                        <a href="/player/dashboard" class="btn btn-secondary btn-abandon">Abandonner</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Zone de texte principale - LARGE -->
        <div class="row story-row">
            <div class="col-12">
                <div class="story-card-large">
                    <div class="story-content-large">
                        <p class="room-description-large">
                            Vous pénétrez dans une salle sombre et humide. Des torches vacillantes projettent des ombres 
                            dansantes sur les murs de pierre ancienne. Au centre de la pièce, un coffre mystérieux attire 
                            votre attention, mais vous entendez des grognements inquiétants dans l'obscurité...
                        </p>
                        <div class="situation-highlight">
                            Que décidez-vous de faire ?
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Zone de choix - 3 boutons côte à côte -->
        <div class="row choices-row">
            <div class="col-4">
                <button class="choice-btn-compact choice-combat w-100" @onclick="@(() => MakeChoice("combat"))"
                    disabled="@isProcessing">
                    Combattre
                    <small>Affronter les créatures élevé</small>
                </button>
            </div>
            <div class="col-4">
                <button class="choice-btn-compact choice-explore w-100" @onclick="@(() => MakeChoice("explore"))"
                    disabled="@isProcessing">
                    Explorer
                    <small>Fouiller la salle modéré</small>
                </button>
            </div>
            <div class="col-4">
                <button class="choice-btn-compact choice-flee w-100" @onclick="@(() => MakeChoice("flee"))"
                    disabled="@isProcessing">
                    Fuir
                    <small>Battre en retraite faible</small>
                </button>
            </div>
        </div>

        <!-- Barre de statut en bas - horizontale -->
        <div class="row status-row">
            <div class="col-12">
                <div class="status-bar-horizontal">
                    <div class="stat-horizontal">
                        <span class="stat-icon">❤️</span>
                        <span class="stat-label">VIE</span>
                        <div class="stat-bar-inline">
                            <div class="stat-fill life-bar" style="width: 85%"></div>
                        </div>
                    </div>
                    <div class="stat-horizontal">
                        <span class="stat-icon">⚡</span>
                        <span class="stat-label">MANA</span>
                        <div class="stat-bar-inline">
                            <div class="stat-fill mana-bar" style="width: 60%"></div>
                        </div>
                    </div>
                    <div class="stat-horizontal">
                        <span class="stat-icon">🏆</span>
                        <span class="stat-label">SCORE</span>
                        <span class="stat-value">1,250</span>
                    </div>
                    <div class="stat-horizontal">
                        <span class="stat-icon">🗝️</span>
                        <span class="stat-label">CLÉS</span>
                        <span class="stat-value">2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid RoomId { get; set; }
    private int totalRooms = 0;
    private Room? currentRoom;
    private bool isProcessing = false;
    private string? resultMessage;
    private int displayedScore = 0;

    private async Task MakeChoice(string choice)
    {
        isProcessing = true;
        resultMessage = null;

        try
        {
            // Utiliser la salle courante fournie par DungeonService si disponible
            var room = DungeonService.CurrentRoom;
            if (room == null)
            {
                resultMessage = "Aucune salle active.";
                return;
            }

            if (GameService.CurrentSessionId == null)
            {
                resultMessage = "Aucune session active côté serveur.";
                return;
            }

            var visit = await GameService.VisitRoomAsync(GameService.CurrentSessionId.Value, room.Id, choice);
            if (visit == null)
            {
                displayedScore += room.PointsReward;
                resultMessage = "Action traitée localement.";
                ToastService.Show(resultMessage, "Action", ToastLevel.Info);
            }
            else
            {
                displayedScore = visit.NewScore;
                resultMessage = visit.Message ?? "";
                ToastService.Show(resultMessage, "Résultat", ToastLevel.Success);

                // Naviguer vers la première salle suivante si fournie
                if (visit.NextRoomIds != null && visit.NextRoomIds.Count > 0)
                {
                    var nextId = visit.NextRoomIds[0];
                    var nextRoom = DungeonService.CurrentDungeon?.Rooms.FirstOrDefault(r => r.Id == nextId);
                    if (nextRoom != null)
                    {
                        DungeonService.NavigateToRoom(nextRoom.Id);
                        NavigationManager.NavigateTo($"/game/room/{nextRoom.Id}");
                    }
                }
                else
                {
                    // aucune salle suivante => fin du donjon
                    await GameService.EndSessionAsync(GameService.CurrentSessionId.Value);
                    ToastService.Show("Donjon terminé. Score sauvegardé.", "Donjon", ToastLevel.Success);
                    NavigationManager.NavigateTo("/game/victory");
                }
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"Erreur: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}

@inject NavigationManager NavigationManager
@inject DungeonService DungeonService
@inject GameService GameService
@inject ToastService ToastService

@code {
    protected override Task OnParametersSetAsync()
    {
        currentRoom = DungeonService.NavigateToRoom(RoomId);
        totalRooms = DungeonService.CurrentDungeon?.Rooms.Count ?? 0;
        return base.OnParametersSetAsync();
    }
}